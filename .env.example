PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=circa
DB_PASSWORD=circa
DB_NAME=circa

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Comma-separated client IDs (iOS / Android / web)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Generate with: openssl rand -base64 32
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Public API base URL used to build OAuth redirect URIs
API_PUBLIC_URL=http://localhost:3000

# Optional frontend redirects after OAuth callback
INTEGRATION_OAUTH_SUCCESS_URL=
INTEGRATION_OAUTH_FAILURE_URL=
INTEGRATION_OAUTH_STATE_TTL_SECONDS=600

# Google Calendar integration OAuth
GOOGLE_INTEGRATION_CLIENT_ID=
GOOGLE_INTEGRATION_CLIENT_SECRET=
GOOGLE_INTEGRATION_REDIRECT_URI=

# Meta (Instagram DM + WhatsApp Cloud) integration OAuth
META_INTEGRATION_APP_ID=
META_INTEGRATION_APP_SECRET=
META_INSTAGRAM_INTEGRATION_REDIRECT_URI=
META_WHATSAPP_INTEGRATION_REDIRECT_URI=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=4096

GENERATE_ONBOARDING_ENERGY_PROFILE_SYSTEM_PROMPT=You are a chronobiology expert specializing in circadian rhythms and cognitive performance. You generate personalized energy profiles for knowledge workers based on their sleep patterns, chronotype, and daily habits. You always respond with valid JSON and nothing else — no preamble, no explanation, no markdown.
GENERATE_WEEKLY_ENERGY_PROFILE_SYSTEM_PROMPT=You are a chronobiology expert specializing in circadian rhythms and cognitive performance. You refine personalized energy profiles for knowledge workers based on their real check-in data. You always respond with valid JSON and nothing else — no preamble, no explanation, no markdown.
GENERATE_DAILY_INSIGHT_SYSTEM_PROMPT=You are a chronobiology expert. You generate one short, specific, actionable nudge for a knowledge worker based on their energy profile and the current time of day. You always respond with plain text only — one sentence, maximum 15 words, no punctuation at the end.

# Optional Expo push access token (recommended for production)
EXPO_ACCESS_TOKEN=

# RevenueCat webhook Authorization bearer token
REVENUECAT_WEBHOOK_SECRET=

# RevenueCat secret API key (sk_...) — used by POST /subscriptions/me/sync to
# repair statuses when a webhook never arrived. Without it, sync is a no-op.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT=pro
