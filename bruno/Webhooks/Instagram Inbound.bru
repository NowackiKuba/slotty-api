meta {
  name: Instagram Inbound
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/webhooks/meta
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "object": "instagram",
    "entry": [
      {
        "id": "ig-business-id",
        "time": 1710000000,
        "messaging": [
          {
            "sender": { "id": "ig-customer-id" },
            "recipient": { "id": "ig-business-id" },
            "timestamp": 1710000000,
            "message": {
              "mid": "mid.instagram.001",
              "text": "Cześć, chcę umówić trening"
            }
          }
        ]
      }
    ]
  }
}

docs {
  Incoming Instagram DM. Trainer is resolved via UserIntegration.externalAccountId.
  Unknown senders are auto-created as GUEST customers.
}
