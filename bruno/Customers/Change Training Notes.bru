meta {
  name: Change Training Notes
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/customers/:customerId/training-notes
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

params:path {
  customerId: {{customerId}}
}

body:json {
  {
    "equipmentToBring": ["racket", "balls"],
    "focusAreas": ["serve", "footwork"],
    "healthNotes": "Mild knee pain",
    "generalNotes": "Prefers outdoor courts"
  }
}
