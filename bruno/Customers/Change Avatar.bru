meta {
  name: Change Avatar
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/customers/:customerId/avatar
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

params:path {
  customerId: {{customerId}}
}

body:json {
  {
    "avatarUrl": "https://example.com/jan-new.png"
  }
}
