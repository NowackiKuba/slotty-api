meta {
  name: Create Broadcast
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/broadcasts
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "messageText": "Cześć, w tym tygodniu treningi odbywają się normalnie.",
    "targetChannel": "WHATSAPP",
    "customerIds": ["{{customerId}}"]
  }
}

script:post-response {
  if ((res.status === 201 || res.status === 200) && res.body && res.body.id) {
    bru.setEnvVar("broadcastId", res.body.id);
  }
}

docs {
  POST /api/broadcasts
  Channel: INSTAGRAM | WHATSAPP | SMS.
}
