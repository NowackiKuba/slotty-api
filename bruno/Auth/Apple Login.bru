meta {
  name: Apple Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/apple
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "idToken": "{{idToken}}",
    "firstName": "Ada",
    "lastName": "Lovelace",
    "displayName": "Ada"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.tokens) {
    bru.setEnvVar("accessToken", res.body.tokens.accessToken);
    bru.setEnvVar("refreshToken", res.body.tokens.refreshToken);
    if (res.body.user && res.body.user.id) {
      bru.setEnvVar("userId", res.body.user.id);
    }
  }
}

docs {
  POST /api/auth/apple — saves accessToken, refreshToken, and userId.
}
