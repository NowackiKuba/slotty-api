meta {
  name: Dev Login
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/auth/dev
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "ada@example.com",
    "firstName": "Ada",
    "lastName": "Lovelace",
    "displayName": "Ada"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.tokens) {
    bru.setEnvVar("accessToken", res.body.tokens.accessToken);
    bru.setEnvVar("refreshToken", res.body.tokens.refreshToken);
    if (res.body.user && res.body.user.id) {
      bru.setEnvVar("userId", res.body.user.id);
    }
  }
}

docs {
  POST /api/auth/dev — local-only. Creates or logs in a user by email. Disabled in production.
}
